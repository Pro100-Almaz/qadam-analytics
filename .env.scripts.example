# Settings for scripts/pull_prod_db.sh. Copy to .env.scripts (gitignored).

# Host alias from ~/.ssh/config
PROD_SSH_HOST=
# Directory on the server where dumps are written
PROD_BACKUP_DIR=
# Postgres container name on the server
PROD_DB_CONTAINER=
# Local dev Postgres container name (docker-compose.dev.yml)
LOCAL_DB_CONTAINER=postgres_dev
