# ── Django ────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE-ME-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key-print-get_random_secret_key
ALLOWED_HOSTS=api.qadam.edu.kz
CSRF_TRUSTED_ORIGINS=https://api.qadam.edu.kz
CORS_ALLOWED_ORIGINS=https://dashboard.qadam.edu.kz

# ── Multi-school (tenant) isolation ──────────────────────────
# Rollout ramp and rollback lever for core/tenancy.py.
#   off      the school filter never applies (pre-tenancy behaviour)
#   warn     filter applies whenever a scope is active; a query with no
#            active scope logs an ERROR with a stack trace and returns
#            unfiltered
#   enforce  a query with no active scope raises SchoolScopeError
#
# Ramp is off -> warn -> (drain the ERROR log) -> enforce, and 'warn' stays
# deployable as a one-variable rollback. Drain with:
#   docker compose logs --since 24h appseed-app celery-worker \
#     | grep -o "[a-zA-Z_]*\.[A-Za-z]* queried outside a school scope" \
#     | sort | uniq -c | sort -rn
#
# Read by BOTH appseed-app and celery-worker. Changing it needs
# `docker compose up -d appseed-app celery-worker` — plain `restart` reuses
# the container's existing environment and will not pick this up.
SCHOOL_SCOPE_MODE=warn

# ── Database ─────────────────────────────────────────────────
DB_NAME=qadam
DB_USER=qadam
DB_PASSWORD=CHANGE-ME-strong-password
DB_HOST=db
DB_PORT=5432

# ── Redis / Celery ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/1
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ── Nginx ────────────────────────────────────────────────────
NGINX_SERVER_NAME=api.qadam.edu.kz

# ── Email (Gmail SMTP) ──────────────────────────────────────
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# ── OpenAI (AI Reports) ─────────────────────────────────────
OPENAI_API_KEY=sk-...
AI_REPORT_MODEL=gpt-4o-mini

# ── MinIO object storage (media files) ───────────────────────
# Bucket is private; Django hands out short-lived presigned URLs.
S3_BUCKET_NAME=qadam-media
S3_REGION=us-east-1
S3_URL_EXPIRE=3600

# Public origin the presigned URLs are signed against. Nginx proxies
# /<bucket>/ to the minio container, preserving the Host header.
S3_ENDPOINT_URL=https://api.qadam.edu.kz

# MinIO superuser — used by the minio + minio-init containers only.
MINIO_ROOT_USER=CHANGE-ME-minio-admin
MINIO_ROOT_PASSWORD=CHANGE-ME-strong-password

# Credentials Django uses. In production create a scoped service account:
#   docker compose exec minio mc alias set local http://minio:9000 "$MINIO_ROOT_USER" "$MINIO_ROOT_PASSWORD"
#   docker compose exec minio mc admin user svcacct add local "$MINIO_ROOT_USER"
# then paste the generated access/secret key below instead of the root ones.
S3_ACCESS_KEY=CHANGE-ME-service-account-access-key
S3_SECRET_KEY=CHANGE-ME-service-account-secret-key
