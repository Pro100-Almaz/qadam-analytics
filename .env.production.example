# ── Django ────────────────────────────────────────────────────
DEBUG=False
SECRET_KEY=CHANGE-ME-generate-with-python-c-from-django.core.management.utils-import-get_random_secret_key-print-get_random_secret_key
ALLOWED_HOSTS=dashboard.qadam.edu.kz,qadam.edu.kz,www.qadam.edu.kz
CSRF_TRUSTED_ORIGINS=https://dashboard.qadam.edu.kz,https://qadam.edu.kz,https://www.qadam.edu.kz
